# Contact form (src/app/api/contact/route.ts) uses Resend to send email.
# Get an API key at https://resend.com and verify a sending domain there.
RESEND_API_KEY=

# Address that submitted contact-form messages are delivered to.
CONTACT_TO_EMAIL=hello@svodigital.com

# Optional: verified "from" address/name once a domain is set up in Resend.
# Defaults to Resend's shared onboarding@resend.dev sender if unset.
CONTACT_FROM_EMAIL="SVO Digital <onboarding@resend.dev>"
